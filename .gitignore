# Local agent dependencies and machine config
.agent-deps/
config/agent.env
config/tasks/*.local.env

# Runtime-generated skill/reference symlinks
.agents/skills/ascendc-*
.agents/skills/cannjudge-submit
docs/kda-prompts

# CANNJudge credential/key material must stay local
**/private.pem
**/public.pem
**/*cannjudge*credential*
**/*cannjudge*secret*
**/*cannjudge*ciphertext*

# Experiment/profiler outputs
runs/*
!runs/.gitkeep
profiles/*
!profiles/.gitkeep
tasks/*/runs/harness/
tasks/*/runs/cannjudge/

# Competition build artifacts
build/
build_out/
output/
dist/
*.run
*.o
*.so
*.log
PROF_*
OPPROF_*
extra-info/

# Python/editor noise
__pycache__/
*.pyc
.venv/
.vscode/
.idea/
.DS_Store
