# Local agent dependencies and machine config
.agent-deps/
config/agent.env
config/tasks/*.local.env

# Runtime-generated skill/reference symlinks
.agents/skills/ascendc-*
.agents/skills/cannjudge-submit
.agents/skills/ascendc-ops-project
docs/kda-prompts

# CANNJudge credential/key material must stay local
**/private.pem
**/public.pem
**/*cannjudge*credential*
**/*cannjudge*secret*
**/*cannjudge*ciphertext*

# Runtime evidence and profiler output: keep compact conclusions in task docs.
runs/*
!runs/.gitkeep
profiles/*
!profiles/.gitkeep
tasks/*/runs/*
tasks/*/profiles/*
cceprint/
**/cceprint/
msprof_output/
**/msprof_output/
PROF_*
OPPROF_*
extra-info/

# Competition build artifacts
build/
build_out/
output/
dist/
*.run
*.o
*.so
*.log

# Python/editor noise
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.venv/
.vscode/
.idea/
.DS_Store
