# Task-scoped Harness configuration for SparseFlashAttention.
TASK_NAME=sparse_flash_attention
TASK_DIR=tasks/sparse_flash_attention
WORKSPACE_DIR=tasks/sparse_flash_attention/workspace
RUN_CWD=repo

GUARD_CMD='bash scripts/guard.sh && git diff --check -- tasks/sparse_flash_attention config/tasks/sparse_flash_attention.env'
BUILD_CMD='tasks/sparse_flash_attention/scripts/build-platform-910b.sh'
VALIDATE_CMD='SPARSE_FLASH_ATTENTION_DEVICE_ID=4 tasks/sparse_flash_attention/scripts/validate-local-a3.sh all'

PERF_OPERATOR_CLASS=auto
PERF_SOURCE_DIRS='tasks/sparse_flash_attention/workspace/code'
PERF_PLAN_LIMIT=5
PERF_ADVANCED=0

CANNJUDGE_CONTEST_ID=6a7bf087a52e0f540a88e167
CANNJUDGE_PUBLIC_PROBLEM_ID=303
CANNJUDGE_PROBLEM_ID=6a7c22d6a52e0f540a8a098d
CANNJUDGE_PROJECT_DIR=tasks/sparse_flash_attention/workspace
CANNJUDGE_MAX_WAIT=900
CANNJUDGE_POLL_INTERVAL=3
PLATFORM_SCORE_DIRECTION=higher
