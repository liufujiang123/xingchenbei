# Copy to config/agent.env on the actual Ascend competition machine.
# This file is intentionally machine-agnostic and safe to commit.

ASCEND_ENV_SETUP=/usr/local/Ascend/ascend-toolkit/set_env.sh

# Relative paths are resolved from repository root.
TASK_NAME=example_task
WORKSPACE_DIR=tasks/example_task/workspace

# Configure these with the platform's real commands.
BUILD_CMD='echo "TODO: configure BUILD_CMD"; exit 2'
VALIDATE_CMD='echo "TODO: configure VALIDATE_CMD"; exit 2'
BENCH_CMD='echo "TODO: configure BENCH_CMD"; exit 2'
PROFILE_CMD='echo "TODO: configure PROFILE_CMD"; exit 2'

# First capture group must be the primary numeric benchmark score.
# This is a Python regular expression, not a POSIX grep expression.
BENCH_SCORE_REGEX='SCORE[=:]\s*([0-9]+(?:\.[0-9]+)?)'

# lower = latency/time; higher = throughput/points.
BENCH_DIRECTION=lower

# Generic Ascend diagnosis configuration.
# auto is recommended; explicit values: vector / cube / mixed_cv.
PERF_OPERATOR_CLASS=auto

# Optional comma/semicolon-separated source roots.
# Empty => scan WORKSPACE_DIR and TASK_DIR while ignoring build/runs/generated noise.
PERF_SOURCE_DIRS=''

# Optional hypothesis tags when the profiler cannot expose a symptom directly.
# Examples: pipeline,memory,bandwidth,cache,compute,latency,underutilization,
# scalar,synchronization,tiling,sparse
PERF_BOTTLENECK_HINTS=''

# Keep the candidate shortlist compact.
PERF_PLAN_LIMIT=5

# Advanced/SOC-sensitive patterns are hidden by default.
PERF_ADVANCED=0

# PROFILE_CMD wrappers may optionally emit stable evidence markers:
#   HARNESS_OPERATOR_CLASS=vector
#   HARNESS_BOTTLENECKS=pipeline,memory
#   HARNESS_PROFILE_NOTE=MTE2 waits dominate the steady state
# Only emit claims actually supported by the profiler.
