# Task-scoped Harness configuration for MhcExpand.
# Credentials are intentionally NOT stored here. Export them only in the shell.

TASK_NAME=mhc_expand
TASK_DIR=tasks/mhc_expand
WORKSPACE_DIR=tasks/mhc_expand/workspace
RUN_CWD=repo

# Gate commands. These scripts are the dual-track entry points produced during
# MhcExpand bring-up: platform build targets 910B; local validation targets A3.
GUARD_CMD='bash scripts/guard.sh && git diff --check -- tasks/mhc_expand'
BUILD_CMD='tasks/mhc_expand/scripts/build-platform-910b.sh'
VALIDATE_CMD='MHC_EXPAND_DEVICE_ID="${MHC_EXPAND_DEVICE_ID:-4}" tasks/mhc_expand/scripts/validate-local-a3.sh'

# Local A3 ACL-event timing is a same-device candidate-screening proxy. It is
# deliberately kept separate from CANNJudge platform evidence.
BENCH_CMD='MHC_EXPAND_DEVICE_ID="${MHC_EXPAND_DEVICE_ID:-4}" tasks/mhc_expand/scripts/bench.sh'
PROFILE_CMD=''
BENCH_DIRECTION=lower
BENCH_SCORE_REGEX='SCORE_TOTAL_MEDIAN_US=([0-9]+([.][0-9]+)?)'

# CANNJudge problem 301 (verified internal id).
CANNJUDGE_PUBLIC_PROBLEM_ID=301
CANNJUDGE_PROBLEM_ID=6a7c1a74a52e0f540a89d39b
CANNJUDGE_PROJECT_DIR=tasks/mhc_expand/workspace
CANNJUDGE_MAX_WAIT=600
CANNJUDGE_POLL_INTERVAL=3
PLATFORM_SCORE_DIRECTION=higher
