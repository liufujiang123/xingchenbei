# Task-scoped Harness configuration for MhcSinkhorn.
TASK_NAME=mhc_sinkhorn
TASK_DIR=tasks/mhc_sinkhorn
WORKSPACE_DIR=tasks/mhc_sinkhorn/workspace
RUN_CWD=repo

GUARD_CMD='bash scripts/guard.sh && git diff --check -- tasks/mhc_sinkhorn config/tasks/mhc_sinkhorn.env'
BUILD_CMD='tasks/mhc_sinkhorn/scripts/build-platform-910b.sh'
VALIDATE_CMD='MHC_SINKHORN_DEVICE_ID=4 tasks/mhc_sinkhorn/scripts/validate.sh'
BENCH_CMD='MHC_SINKHORN_DEVICE_ID=4 tasks/mhc_sinkhorn/scripts/bench.sh'
PROFILE_CMD='MHC_SINKHORN_DEVICE_ID=4 tasks/mhc_sinkhorn/scripts/profile-local-a3.sh harness_profile'
BENCH_DIRECTION=lower
BENCH_SCORE_REGEX='SCORE_TOTAL_MEDIAN_US=([0-9]+([.][0-9]+)?)'

PERF_OPERATOR_CLASS=vector
PERF_SOURCE_DIRS='tasks/mhc_sinkhorn/workspace/code'
PERF_PLAN_LIMIT=5
PERF_ADVANCED=0

CANNJUDGE_CONTEST_ID=6a7bf087a52e0f540a88e167
CANNJUDGE_PUBLIC_PROBLEM_ID=302
CANNJUDGE_PROBLEM_ID=6a7c2267a52e0f540a8a02bd
CANNJUDGE_PROJECT_DIR=tasks/mhc_sinkhorn/workspace
CANNJUDGE_MAX_WAIT=600
CANNJUDGE_POLL_INTERVAL=3
PLATFORM_SCORE_DIRECTION=higher
